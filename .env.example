# Optional voice connection. Terminal chats do not require this key.
OPENAI_API_KEY=

# Optional fal.ai generation account.
FAL_KEY=

# Optional coordinator model override; blank uses the Codex account default.
MRMAK_COORDINATOR_MODEL=

# Optional TypeSafe account. Jev then chooses the agent and effort for new worker chats;
# without it, the built-in keyword rules apply.
TYPESAFE_API_KEY=

# Optional extra provider account. No service uses it automatically.
OPENROUTER_API_KEY=
